{
	"name": "deadslog",
	"version": "1.3.1",
	"description": "A dead simple logger module for Node.js",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"types",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "bunx vitest run",
		"coverage": "bunx vitest run --coverage",
		"build": "bun run build.js && bunx tsc",
		"prepare": "bun run build",
		"release": "commit-and-tag-version"
	},
	"keywords": [
		"logger",
		"logging",
		"chalk",
		"file-log",
		"cli",
		"colored-logs",
		"rotating"
	],
	"author": "c4lyp5o",
	"license": "MIT",
	"dependencies": {
		"yoctocolors": "^2.2.0"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.5",
		"commit-and-tag-version": "^13.3.0",
		"esbuild": "^0.28.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/c4lyp5o/deadslog.git"
	},
	"bugs": {
		"url": "https://github.com/c4lyp5o/deadslog/issues"
	},
	"homepage": "https://github.com/c4lyp5o/deadslog#readme"
}
